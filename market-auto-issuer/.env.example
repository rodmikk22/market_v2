# ============================================================
# Market Auto Issuer — Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# ── Yandex Market API ────────────────────────────────────────
# Your Partner API token (starts with ACMA:)
MARKET_API_TOKEN=ACMA:your_token_here

# Partner API base URL (don't change unless Yandex updates it)
MARKET_API_BASE=https://api.partner.market.yandex.ru

# Your business ID (shown in Partner Cabinet URL)
MARKET_BUSINESS_ID=123456789

# Your campaign ID (shown in Partner Cabinet URL)
MARKET_CAMPAIGN_ID=987654321

# ── Webhook Security ─────────────────────────────────────────
# Optional HMAC-SHA256 secret.  Leave empty to disable check.
WEBHOOK_SHARED_SECRET=

# ── Delivery ─────────────────────────────────────────────────
# yandex_digital  → calls real deliverDigitalGoods API
# dry_run         → logs but does NOT call Market API (for testing)
DELIVERY_MODE=yandex_digital

# ── Database ─────────────────────────────────────────────────
# Overridden by docker-compose.yml when running in Docker.
# Use this only when running locally without Docker.
DATABASE_URL=postgresql://marketuser:marketpass@localhost:5432/marketdb

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Admin UI ─────────────────────────────────────────────────
# Password shown to all admin users (basic protection)
ADMIN_SECRET=changeme_please

# ── App ──────────────────────────────────────────────────────
APP_NAME=Market Auto Issuer
APP_VERSION=1.0.0
DEBUG=false

# ── Order statuses that trigger fulfillment ──────────────────
# Comma-separated.  PROCESSING is the typical DBS value.
ALLOWED_ISSUE_STATUSES=["PROCESSING","DELIVERY","PICKUP"]
